# Copy this file to .env and fill in your credentials.
# Never commit .env — it is already in .gitignore.

# ── OpenRouter (LLM) ──────────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional standby credential(s). When the primary key is rejected for a
# key-specific reason — out of credits, revoked, account-level quota — the
# client marks it exhausted and retries the same request on the next key, then
# keeps using whichever one works. Request-level faults (bad model slug) do NOT
# rotate, since every key would fail identically. Comma-separate for several.
# Exhausted keys are retried after a 5-minute cooldown in case credits are added.
OPENROUTER_FALLBACK_API_KEY=sk-or-v1-your_standby_key_here

# LiteLLM model slug. Keep the `openrouter/` provider prefix — without it
# LiteLLM cannot route the request. Do NOT append `:free`; that variant is not a
# valid slug and the provider answers 404.
LLM_MODEL=openrouter/meta-llama/llama-3.1-70b-instruct

# Per-request ceiling and attempt budget for LLM calls. Only retryable failures
# (timeout, 429, 5xx) consume an attempt — auth/quota errors fail immediately.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3

# ── Neon PostgreSQL (pgvector extension required) ─────────────────────────────
# Get a free database at https://neon.tech
# `sslmode` and `channel_binding` are stripped automatically — asyncpg does not
# accept them as query parameters.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Embeddings (local, free — downloads ~400MB on first run) ──────────────────
# EMBEDDING_DIMENSIONS must match the Vector(...) column on prohibited_patterns.
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768

# Cosine similarity above this threshold flags a product as prohibited.
PROHIBITED_SIMILARITY_THRESHOLD=0.75

# ── Limits ────────────────────────────────────────────────────────────────────
# Concurrent inspections admitted by the API. Each one holds a browser context,
# an embedding batch, and a database connection, so this bounds resource use.
MAX_CONCURRENT_INSPECTIONS=5
# Products embedded and vector-searched per scan.
MAX_PRODUCTS_PER_SCAN=20
# Whole-pipeline budget for one inspection (scrape + agents + narrative).
INSPECTION_TIMEOUT_SECONDS=180

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to stop echoing internal exception text in API responses.
ENVIRONMENT=development

# Exact browser origins allowed to call the API (comma-separated).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
# Regex for dynamic origins such as Vercel previews. Wildcards do NOT work in
# CORS_ALLOW_ORIGINS — Starlette matches those by exact string only.
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app
