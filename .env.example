# Copy this file to .env and fill in your credentials
# Never commit .env — it is already in .gitignore

# --- OpenRouter (LLM) ---
# Get your free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-70b-instruct:free

# --- Neon PostgreSQL (must have pgvector extension enabled) ---
# Get a free DB at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# --- Embedding (local, free — downloads ~400MB on first run) ---
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# --- Concurrency ---
MAX_CONCURRENT_INSPECTIONS=5
